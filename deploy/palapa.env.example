# Salin ke /etc/palapa.env  (sudo nano /etc/palapa.env)  lalu: sudo chmod 600 /etc/palapa.env
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/palapa
COOKIE_SECURE=1
SITE_URL=https://palapadentists.com
# Hanya dipakai saat PERTAMA kali server jalan (database belum punya akun). Hapus dua baris ini setelah login pertama.
ADMIN_USER=admin
ADMIN_PASS=GANTI-DENGAN-PASSWORD-KUAT
